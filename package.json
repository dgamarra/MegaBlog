{
  "name": "megablog",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack blogging platform with JWT authentication and NLP analysis of posts",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install",
    "install:server": "npm install --workspace server --include-workspace-root",
    "install:client": "npm install --workspace client --include-workspace-root",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "lint": "npm run lint --workspace client"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "dependencies": {
    "@parcel/watcher": "^2.6.0",
    "node-gyp": "^13.1.0",
    "rebuild": "^0.1.2"
  }
}
